# Copy to server/.env and fill in.
NODE_ENV=development
PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mannu

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React dev server runs (only used in development for CORS)
CLIENT_URL=http://localhost:5173

# Optional: product photos go to Cloudinary when this is set, otherwise to server/uploads/
# Find it in Cloudinary dashboard → API Keys → "API environment variable"
CLOUDINARY_URL=
